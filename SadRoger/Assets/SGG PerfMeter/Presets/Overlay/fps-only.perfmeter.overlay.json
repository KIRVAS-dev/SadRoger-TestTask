{
    "schema": "sgg-perfmeter.overlay-preset",
    "version": 1,
    "id": "fps-only",
    "displayName": "FPS Only",
    "description": "Super-minimal one-line overlay with current FPS, average FPS, 1% low, 0.1% low, and render-thread time.",
    "tags": [],
    "style": {
        "anchor": "TopRight",
        "layout": "FpsOnly",
        "theme": "ClassicDark",
        "font": "Manrope",
        "scale": 1.0,
        "opacity": 0.8399999737739563,
        "maxWidth": 360,
        "gap": 4
    },
    "widgets": [
        {
            "id": "fps.summary-card",
            "enabled": true,
            "order": 10,
            "variant": "",
            "height": 0
        },
        {
            "id": "timing.cpu-card",
            "enabled": true,
            "order": 20,
            "variant": "",
            "height": 0
        }
    ]
}