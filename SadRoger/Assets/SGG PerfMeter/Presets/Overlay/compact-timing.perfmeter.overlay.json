{
    "schema": "sgg-perfmeter.overlay-preset",
    "version": 1,
    "id": "compact-timing",
    "displayName": "Compact Timing",
    "description": "Compact overlay with FPS, CPU/GPU timing cards and budget bars.",
    "tags": [],
    "style": {
        "anchor": "TopRight",
        "layout": "CompactCards",
        "theme": "ClassicDark",
        "font": "Manrope",
        "scale": 1.0,
        "opacity": 0.8399999737739563,
        "maxWidth": 420,
        "gap": 4
    },
    "widgets": [
        {
            "id": "fps.summary-card",
            "enabled": true,
            "order": 10,
            "variant": "",
            "height": 0
        },
        {
            "id": "timing.cpu-card",
            "enabled": true,
            "order": 20,
            "variant": "",
            "height": 0
        },
        {
            "id": "timing.gpu-card",
            "enabled": true,
            "order": 30,
            "variant": "",
            "height": 0
        },
        {
            "id": "timing.cpu-budget-bar",
            "enabled": true,
            "order": 40,
            "variant": "",
            "height": 0
        },
        {
            "id": "timing.gpu-budget-bar",
            "enabled": true,
            "order": 50,
            "variant": "",
            "height": 0
        }
    ]
